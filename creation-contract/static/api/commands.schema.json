    "Op_layer_delete": {
      "type": "object",
      "properties": {
        "op": {
          "const": "layer.delete"
        },
        "target": {
          "$ref": "#/$defs/Id"
        },
        "cascade": {
          "type": "boolean"
        },
        "dependentLinks": {
          "enum": [
            "reject",
            "detach"
          ]
        }
      },
      "required": [
        "op",
        "target"
      ],
      "additionalProperties": false
    },
    "Op_group_create": {
      "type": "object",
      "properties": {
        "op": {
          "const": "group.create"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "place": {
          "$ref": "#/$defs/Place"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "minItems": 2,
          "maxItems": 200
        },
        "layoutBox": {
          "$ref": "#/$defs/LayoutBox"
        }
      },
      "required": [
        "op",
        "id",
        "targets"
      ],
      "additionalProperties": false
    },
    "Op_group_compose": {
      "type": "object",
      "properties": {
        "op": {
          "const": "group.compose"
