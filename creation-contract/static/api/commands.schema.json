        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "target": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "op",
        "target"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "place"
          ]
        },
        {
          "required": [
            "size"
          ]
        },
        {
          "required": [
            "style"
          ]
        },
        {
          "required": [
            "order"
          ]
        }
      ]
    },
    "Op_layer_reparent": {
      "type": "object",
      "properties": {
        "op": {
          "const": "layer.reparent"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
        "target": {
          "$ref": "#/$defs/Id"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "const": null
            }
          ]
        },
        "preserveWorld": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "op",
        "target",
        "parent"
      ],
      "additionalProperties": false
    },
    "Op_layer_reorder": {
      "type": "object",
      "properties": {
        "op": {
          "const": "layer.reorder"
        },
        "order": {
          "$ref": "#/$defs/Order"
        },
