{
  "name": "shiye-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-offline-runtime.mjs",
    "dev": "vite --host 0.0.0.0",
    "start:local": "node server/server.mjs",
    "build": "node scripts/build-offline-runtime.mjs && vite build && node scripts/license-notices.mjs && node scripts/precache.mjs",
    "pretest": "node scripts/build-offline-runtime.mjs",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:browser": "node tests/browser-acceptance.mjs",
    "test:editor-browser": "node tests/editor-browser-acceptance.mjs",
    "test:selection-browser": "node tests/library-selection-browser.mjs",
    "test:layout-browser": "node tests/layout-preview-browser.mjs",
    "test:layers-browser": "node tests/catalog-layers-browser.mjs",
    "test:interaction-browser": "node tests/interaction-browser.mjs",
    "test:ui": "npm run build && node tests/ui-smoke.mjs && node tests/route-parity-smoke.mjs && node tests/self-host-smoke.mjs",
    "test:responsive-browser": "node tests/responsive-visual-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@noble/hashes": "2.0.1",
    "@panzoom/panzoom": "4.6.2",
    "@supabase/supabase-js": "2.117.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "ajv": "8.20.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "eventsource-parser": "4.1.1",
    "fflate": "0.8.2",
    "idb": "8.0.3",
    "lucide": "1.48.0",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "polygon-clipping": "0.15.7"
  }
}
