[Unit]
Description=Shiye Journal self-hosted PWA and data API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_LINUX_USER
WorkingDirectory=/home/REPLACE_WITH_LINUX_USER/Desktop/拾页项目/网页应用/shiye-journal-main
EnvironmentFile=/etc/shiye/shiye.env
ExecStart=/usr/bin/node server/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/REPLACE_WITH_LINUX_USER/Desktop/拾页项目/数据备份/实时数据

[Install]
WantedBy=multi-user.target
