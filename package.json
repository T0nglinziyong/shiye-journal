{
  "name": "shiye-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start:local": "node server/server.mjs",
    "build": "vite build && node scripts/license-notices.mjs && node scripts/precache.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-acceptance.mjs",
    "test:editor-browser": "node tests/editor-browser-acceptance.mjs",
    "test:selection-browser": "node tests/library-selection-browser.mjs",
    "test:layout-browser": "node tests/layout-preview-browser.mjs",
    "test:interaction-browser": "node tests/interaction-browser.mjs",
    "test:ui": "npm run build && node tests/ui-smoke.mjs && node tests/route-parity-smoke.mjs && node tests/self-host-smoke.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@panzoom/panzoom": "4.6.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "ajv": "8.20.0",
    "idb": "8.0.3",
    "lucide": "1.48.0",
    "pdf-lib": "1.17.1"
  }
}
